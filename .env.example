DATABASE_URL="postgresql://routecalc:routecalc@db:5432/routecalc?schema=public"

# Session / JWT
SESSION_SECRET="change-me-to-a-long-random-string-in-production"

# SMTP (bestehender Mailserver)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user@example.com"
SMTP_PASSWORD="changeme"
SMTP_FROM="Medical Operations Center <no-reply@example.com>"

# OpenRouteService (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY="changeme"

# Photon (Adress-Autocomplete, OSM-Daten, komoot) - Standard-Endpoint,
# ggf. eigenen Server eintragen. Kein API-Key nötig.
PHOTON_URL="https://photon.komoot.io/api"
GEOCODER_CONTACT_EMAIL="dispo@example.com"

# Basis-URL der App (fuer Links in E-Mails)
APP_URL="http://localhost:3000"

